{% extends '@WebSchedulerModule/backOffice/default-twig/webscheduler/_layout.html.twig' %}

{% block ws_title %}{{ 'Executions'|trans({}, 'webscheduler') }}{% endblock %}

{% block ws_breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Executions'|trans({}, 'webscheduler') }}</li>
{% endblock %}

{% block ws_body %}
    <div class="card" data-testid="webscheduler-execution-list">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">{{ 'Task'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'Triggered at'|trans({}, 'webscheduler') }}</th>
                        <th scope="col" class="text-center">{{ 'Status'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'Strategy'|trans({}, 'webscheduler') }}</th>
                        <th scope="col" class="text-center">{{ 'Exit code'|trans({}, 'webscheduler') }}</th>
                        <th scope="col" class="text-end">{{ 'Duration'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'IP'|trans({}, 'webscheduler') }}</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr data-testid="webscheduler-execution-row">
                            <td>{{ row.id }}</td>
                            <td>{{ row.task ?: '—' }}</td>
                            <td>{{ row.triggered_at ?: '—' }}</td>
                            <td class="text-center"><span class="badge text-bg-{{ row.status_variant }}">{{ row.status_label }}</span></td>
                            <td><small>{{ row.strategy ?: '—' }}</small></td>
                            <td class="text-center">{{ row.exit_code is null ? '—' : row.exit_code }}</td>
                            <td class="text-end">{{ row.duration ?: '—' }}</td>
                            <td><small>{{ row.trigger_ip ?: '—' }}</small></td>
                            <td class="text-end">
                                <a href="{{ row.detail_url }}" class="btn btn-sm btn-outline-secondary"
                                   title="{{ 'Details'|trans({}, 'webscheduler') }}">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4" data-testid="webscheduler-execution-list-empty">
                                {{ 'No execution yet.'|trans({}, 'webscheduler') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if page > 1 or has_next %}
        <nav class="mt-3" aria-label="{{ 'Pagination'|trans({}, 'webscheduler') }}">
            <ul class="pagination mb-0">
                <li class="page-item{{ page <= 1 ? ' disabled' : '' }}">
                    {% if page <= 1 %}
                        <span class="page-link">&lsaquo;</span>
                    {% else %}
                        <a class="page-link" href="?page={{ page - 1 }}{% if task_id %}&amp;task_id={{ task_id }}{% endif %}">&lsaquo;</a>
                    {% endif %}
                </li>
                <li class="page-item active" aria-current="page"><span class="page-link">{{ page }}</span></li>
                <li class="page-item{{ has_next ? '' : ' disabled' }}">
                    {% if has_next %}
                        <a class="page-link" href="?page={{ page + 1 }}{% if task_id %}&amp;task_id={{ task_id }}{% endif %}">&rsaquo;</a>
                    {% else %}
                        <span class="page-link">&rsaquo;</span>
                    {% endif %}
                </li>
            </ul>
        </nav>
    {% endif %}
{% endblock %}
