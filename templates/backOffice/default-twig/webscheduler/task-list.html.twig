{% extends '@WebSchedulerModule/backOffice/default-twig/webscheduler/_layout.html.twig' %}

{% block ws_title %}{{ 'Tasks'|trans({}, 'webscheduler') }}{% endblock %}

{% block ws_breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Tasks'|trans({}, 'webscheduler') }}</li>
{% endblock %}

{% block ws_toolbar %}
    <a href="{{ path('webscheduler.admin.task.create') }}" class="btn btn-sm btn-primary" data-testid="webscheduler-task-create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Create a task'|trans({}, 'webscheduler') }}
    </a>
    {{ parent() }}
{% endblock %}

{% block ws_body %}
    <div class="card" data-testid="webscheduler-task-list">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">{{ 'Title'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'Command'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'Strategy'|trans({}, 'webscheduler') }}</th>
                        <th scope="col" class="text-center">{{ 'Enabled'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'Last triggered'|trans({}, 'webscheduler') }}</th>
                        <th scope="col">{{ 'Trigger URL'|trans({}, 'webscheduler') }}</th>
                        <th scope="col" class="text-end" style="width: 190px;">{{ 'Actions'|trans({}, 'webscheduler') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in tasks %}
                        <tr data-testid="webscheduler-task-row">
                            <td>{{ entry.title }}</td>
                            <td>
                                <code>{{ entry.command_name }}</code>
                                {% if entry.command_arguments %}<small class="text-muted d-block">{{ entry.command_arguments }}</small>{% endif %}
                            </td>
                            <td><span class="badge text-bg-secondary">{{ entry.strategy_label }}</span></td>
                            <td class="text-center">
                                {% if entry.enabled %}
                                    <span class="badge text-bg-success">{{ 'Yes'|trans({}, 'webscheduler') }}</span>
                                {% else %}
                                    <span class="badge text-bg-warning">{{ 'No'|trans({}, 'webscheduler') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ entry.last_triggered_at ?: '—' }}</td>
                            <td style="min-width: 240px;">
                                <div class="input-group input-group-sm" data-controller="bo-copy">
                                    <input type="text" class="form-control font-monospace" style="font-size: .72rem;"
                                           readonly value="{{ entry.trigger_url }}"
                                           onclick="this.select();"
                                           data-testid="webscheduler-trigger-url">
                                    <button type="button" class="btn btn-outline-secondary"
                                            title="{{ 'Copy URL'|trans({}, 'webscheduler') }}"
                                            onclick="navigator.clipboard.writeText(this.previousElementSibling.value);">
                                        <i class="bi bi-clipboard" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="{{ entry.edit_url }}" class="btn btn-sm btn-outline-primary"
                                       title="{{ 'Edit task'|trans({}, 'webscheduler') }}">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    </a>
                                    <form action="{{ entry.trigger_action_url }}" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-info"
                                                title="{{ 'Trigger now'|trans({}, 'webscheduler') }}">
                                            <i class="bi bi-play-fill" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                    <form action="{{ entry.toggle_url }}" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                title="{{ entry.enabled ? 'Disable'|trans({}, 'webscheduler.bo.default-twig') : 'Enable'|trans({}, 'webscheduler.bo.default-twig') }}">
                                            <i class="bi {{ entry.enabled ? 'bi-pause-fill' : 'bi-play-circle' }}" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                    <form action="{{ entry.delete_url }}" method="post" class="d-inline"
                                          onsubmit="return confirm({{ 'Delete this task?'|trans({}, 'webscheduler')|json_encode|raw }});">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="{{ 'Delete'|trans({}, 'webscheduler') }}">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4" data-testid="webscheduler-task-list-empty">
                                {{ 'No task yet.'|trans({}, 'webscheduler') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if available_commands is not empty %}
        <div class="card mt-3">
            <div class="card-header bg-body-tertiary">
                <h2 class="h6 mb-0">{{ 'Available commands'|trans({}, 'webscheduler.bo.default-twig') }}</h2>
            </div>
            <ul class="list-group list-group-flush">
                {% for command in available_commands %}
                    <li class="list-group-item d-flex flex-wrap gap-2 align-items-baseline">
                        <code>{{ command.name }}</code>
                        <small class="text-muted">{{ command.description }}</small>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
